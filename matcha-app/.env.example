DATABASE_PATH=./data/matcha.db

# Signature des jetons d'acces - en prod : openssl rand -hex 32
AUTH_SECRET=dev-secret-change-me

# Duree de vie des jetons, en secondes
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000
EMAIL_TOKEN_TTL=900

# SMTP Gmail (mot de passe d'application, sans les espaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Matcha <your.address@gmail.com>"
APP_URL=http://localhost:3000

# Geocodage - aucune cle requise
PHOTON_URL=https://photon.komoot.io
BAN_URL=https://api-adresse.data.gouv.fr
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Pusher Channels
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Chiffrement des messages - en prod : openssl rand -hex 32
MESSAGES_KEY=

# Bonus - Chat Audio (TURN) - dashboard.metered.ca
STUN_URLS=stun:stun.relay.metered.ca:80,stun:stun.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
